DATABASE_URL="postgresql://narasumber:narasumber_dev@localhost:5433/narasumber"

# Minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=""

# 64 karakter hex (32 byte). Kunci enkripsi NIK, NPWP, rekening.
NUXT_KUNCI_ENKRIPSI=""
# 64 karakter hex. Kunci HMAC untuk indeks unik NIK.
NUXT_KUNCI_INDEKS=""

# Alamat aplikasi, dipakai untuk link di email.
NUXT_PUBLIC_URL_APLIKASI="http://localhost:3000"
NUXT_PUBLIC_MYASN_URL="https://myasn.bkn.go.id"

# Kosongkan SMTP_HOST di pengembangan: email dicetak ke konsol server.
NUXT_SMTP_HOST=""
NUXT_SMTP_PORT="587"
NUXT_SMTP_USER=""
NUXT_SMTP_PASS=""
NUXT_SMTP_FROM="Database Narasumber LAN <no-reply@lan.go.id>"

# Isi "true" hanya bila aplikasi berada di belakang reverse proxy milik sendiri yang mengisi X-Forwarded-For.
NUXT_PERCAYA_PROXY="false"

# Pemindaian antivirus unggahan (NFR-09) lewat clamd. Kosongkan untuk menonaktifkan.
NUXT_CLAMAV_HOST=""
NUXT_CLAMAV_PORT="3310"

# Penyimpanan dokumen S3-compatible (mis. Supabase Storage: https://<host>/storage/v1/s3, path-style).
# Wajib di Vercel. Kosongkan NUXT_S3_ENDPOINT di pengembangan untuk menyimpan ke folder .data/dokumen.
# Bucket harus privat; dokumen hanya disajikan lewat endpoint aplikasi yang mengecek role.
NUXT_S3_ENDPOINT=""
NUXT_S3_REGION="us-east-1"
NUXT_S3_BUCKET="dokumen"
NUXT_S3_ACCESS_KEY_ID=""
NUXT_S3_SECRET_ACCESS_KEY=""

# Akun Super Admin pertama, dibuat oleh seed.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
